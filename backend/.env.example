NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/arcdraw

# Required: generate a random secret of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-random-secret-at-least-32-characters
JWT_ISSUER=arcdraw-api
JWT_AUDIENCE=arcdraw-client
SESSION_DAYS=30
OTP_HASH_SECRET=replace-with-another-random-secret-at-least-32-characters

CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Optional OAuth providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/v1/auth/github/callback

# Brevo Transactional Email API (email OTP + password-reset OTP).
# Create a Brevo API key and verify the sender/domain in Brevo before sending.
BREVO_API_KEY=
MAIL_FROM_NAME=ArcDraw
MAIL_FROM_EMAIL=no-reply@your-verified-domain.com

# ArcDraw Design Agent. Keep this key on the backend only; never use VITE_.
AI_API_KEY=
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_REQUEST_TIMEOUT_MS=110000
